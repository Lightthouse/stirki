{$DOMAIN} {
	# Advertising images proxy
	handle /advertising/* {
		reverse_proxy backend:8000
	}

	# API proxy (first — so POST requests don't hit file_server)
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Admin panel
	handle /admin* {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Файлы сборки: в имени хэш содержимого, при выкладке имя меняется — кэшируем надолго.
	# Отдельным блоком без try_files: отсутствующий файл — 404, а не index.html, закэшированный на год как JS.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Frontend SPA: страницы (/, /order, /login…) и прочие файлы — без кэша, браузер каждый раз сверяется
	# с сервером (по ETag, ответ 304 без тела), поэтому новая версия видна при первом же открытии.
	handle {
		root * /srv
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}

# www → основной домен (сертификат на www Caddy получит сам)
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
