{$DOMAIN} {
	# Advertising images proxy
	handle /advertising/* {
		reverse_proxy backend:8000
	}

	# API proxy (first — so POST requests don't hit file_server)
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Frontend SPA
	handle {
		root * /srv
		try_files {path} /index.html

		# SW и index.html — без кэша, чтобы браузер сразу видел обновления
		@nocache path /sw.js /index.html /manifest.webmanifest
		header @nocache Cache-Control "no-cache, no-store, must-revalidate"

		file_server
	}
}