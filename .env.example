# PostgreSQL
DB_USER=stirki
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stirki

# Домен (для prod — используется в Caddy)
DOMAIN=stirkaon.ru


# Секретный ключ (обязателен для prod)
SECRET_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Окружение: development = тестовый режим SMS + код в консоли; production = реальные SMS
APP_ENV=development

# SmsAero
SMSAERO_EMAIL=
SMSAERO_API_KEY=
SMSAERO_SIGN=SMS

# Точка банк
TOCHKA_TOKEN=
TOCHKA_CUSTOMER_CODE_BUISNESS=
TOCHKA_CUSTOMER_CODE_PERSONAL=

# Админки (опционально)
ADMINER_PORT=8081
BASEROW_PORT=8082

# Baserow — мониторинг клиентов для менеджеров
# 1. Открой Baserow (http://localhost:8082), создай аккаунт
# 2. Создай базу с двумя таблицами:
#    - "Клиенты": поля Телефон (Text), Зарегистрирован (Text)
#    - "Заказы": поля ID заказа (Number), Телефон клиента (Text),
#      Мешков (Number), Услуги (Text), Сумма (руб) (Number),
#      Статус (Text), Оплата (Text), Создан (Text)
# 3. Настройки → Токены API → создай токен
# 4. ID таблиц: откройте таблицу, ID в URL (/database/N/table/ID/)
BASEROW_URL=http://localhost:8082
BASEROW_API_TOKEN=
BASEROW_CLIENTS_TABLE_ID=
BASEROW_ORDERS_TABLE_ID=

