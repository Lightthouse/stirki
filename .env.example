# PostgreSQL
DB_USER=stirki
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stirki

# Домен (для prod — используется в Caddy)
DOMAIN=stirkaon.com

# Секретный ключ (обязателен для prod)
# обязательны (openssl rand -hex 32), без них бэкенд не запускается
SECRET_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# SmsAero
SMSAERO_EMAIL=
SMSAERO_API_KEY=
# имя отправителя, одобренное в кабинете SmsAero; пусто — тестовое «Sms Aero». Включение SMS — флаг в админке
SMSAERO_SIGN=

# Точка банк
TOCHKA_TOKEN=
TOCHKA_CUSTOMER_CODE_BUISNESS=
TOCHKA_CUSTOMER_CODE_PERSONAL=
# торговая точка (merchantId из GET /acquiring/v1.0/retailers); обязательна при нескольких точках
TOCHKA_MERCHANT_ID=
# система налогообложения для чека: osn | usn_income | usn_income_outcome | esn | patent (пусто — не передаётся)
TOCHKA_TAX_SYSTEM_CODE=

# Email-уведомления операторам о новых заказах (SMTP, SSL).
# Для ящика на mail.ru: smtp.mail.ru:465, SMTP_PASSWORD — «пароль для внешних приложений»
# (Настройки ящика → Безопасность → Пароли для внешних приложений).
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Получатели уведомлений — один или несколько адресов через запятую: admin1@example.ru, admin2@example.ru
NOTIFY_EMAIL=

# Админки (опционально)
ADMINER_PORT=8081

